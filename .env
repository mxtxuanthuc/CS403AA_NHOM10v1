# ===========================
# Environment Configuration
# ===========================

# Server
NODE_ENV=development
PORT=3000

# Session Secret (generate with: openssl rand -hex 32)
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# ===========================
# OAUTH - Google
# ===========================
# Instructions:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project
# 3. Enable OAuth 2.0 consent screen
# 4. Create OAuth 2.0 credentials (Web application)
# 5. Add redirect URI: http://localhost:3000/auth/google/callback

GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ===========================
# OAUTH - Facebook
# ===========================
# Instructions:
# 1. Go to https://developers.facebook.com/
# 2. Create a new app
# 3. Add Facebook Login product
# 4. Configure OAuth redirect URIs
# 5. Add: http://localhost:3000/auth/facebook/callback

FACEBOOK_CLIENT_ID=your-facebook-app-id-here
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret-here

# ===========================
# OAuth Callback URL
# ===========================
# For development: http://localhost:3000
# For production: https://yourdomain.com
OAUTH_CALLBACK_URL=http://localhost:3000

# ===========================
# Email Configuration
# ===========================
# Using Gmail:
# 1. Enable 2-Step Verification
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Generate app password
# 4. Use that password below

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-specific-password
MAIL_FROM=noreply@iot-ai-monitor.local

# Alternative: Using SendGrid
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USER=apikey
# MAIL_PASS=SG.your-sendgrid-api-key

# ===========================
# Database
# ===========================
DB_PATH=./data/iot.db

# ===========================
# AI Services
# ===========================
# Choose: openai, groq, or local
AI_TYPE=local

# If using OpenAI
OPENAI_API_KEY=your-openai-api-key-here

# If using Groq
GROQ_API_KEY=your-groq-api-key-here

# ===========================
# Weather API
# ===========================
OPENWEATHER_API_KEY=your-openweathermap-api-key
OPENWEATHER_LAT=21.0285
OPENWEATHER_LON=105.8542

# ===========================
# Application Settings
# ===========================
APP_NAME=IoT-AI Monitor
APP_VERSION=1.0.0
LOG_LEVEL=info

# ===========================
# Security
# ===========================
# HTTPS settings (for production)
HTTPS_ENABLED=false
SSL_CERT_PATH=
SSL_KEY_PATH=

# CORS settings
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
